            "device": "PC2",
            "address": "192.168.1.11",
            "prefix_len": 24
          }
        ]
      },
      {
        "title": "Ping PC2 from PC1",
        "checks": [
          {
            "check": "ping",
            "from": "PC1",
            "to": "PC2"
          }
        ],
        "detail": "Double-click PC1 to open its console and type `ping 192.168.1.11`.",
        "hint": "The first reply may take longer: PC1 asks for PC2's MAC address with ARP first."
