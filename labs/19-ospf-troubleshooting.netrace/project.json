  "lab": {
    "title": "Fixing OSPF",
    "topic": "Routing",
    "brief": "OSPF is configured on all three routers, but two adjacencies never come up. Find the two mistakes and fix them. The OSPF tab names what's wrong with each neighbour; `show ip ospf interface` agrees.",
    "tasks": [
      {
        "title": "R2 and R3 become neighbours",
        "checks": [
          {
            "check": "ospf_neighbors",
            "device": "R2",
            "count": 2
          }
        ],
        "hint": "Hellos carry the area ID, and both ends must agree."
      },
      {
        "title": "R1 and R3 become neighbours",
        "checks": [
          {
            "check": "ospf_neighbors",
            "device": "R1",
            "count": 2
          },
          {
            "check": "ospf_neighbors",
            "device": "R3",
            "count": 2
          }
        ],
        "hint": "Hello and dead timers must match exactly on both ends of a link."
      },
      {
        "title": "PC1 can ping PC3",
        "checks": [
          {
            "check": "ping",
            "from": "PC1",
            "to": "PC3"
          }
        ]
      }
    ]
