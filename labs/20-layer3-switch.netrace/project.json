  "annotations": [],
  "lab": {
    "title": "Routing on a layer 3 switch",
    "topic": "Switching",
    "brief": "A multilayer switch can route between VLANs itself, with no router: one **SVI** (interface Vlan N) per VLAN as the gateway, and `ip routing` turned on.",
    "tasks": [
      {
        "title": "VLANs 10 and 20 with a port each",
        "checks": [
          {
            "check": "vlan",
            "device": "DSW1",
            "vlan": 10
          },
          {
            "check": "vlan",
            "device": "DSW1",
            "vlan": 20
          },
          {
            "check": "access_port",
            "device": "DSW1",
            "port": "Gi1/0/1",
            "vlan": 10
          },
          {
            "check": "access_port",
            "device": "DSW1",
            "port": "Gi1/0/2",
            "vlan": 20
          }
        ]
      },
      {
        "title": "SVIs are the gateways",
        "checks": [
          {
            "check": "address",
            "device": "DSW1",
            "address": "192.168.10.1",
            "prefix_len": 24,
            "interface": "Vlan10"
          },
          {
            "check": "address",
            "device": "DSW1",
            "address": "192.168.20.1",
            "prefix_len": 24,
            "interface": "Vlan20"
          }
        ],
        "detail": "`interface vlan 10`, `ip address 192.168.10.1 255.255.255.0`, `no shutdown`."
      },
      {
        "title": "Routing is on",
        "checks": [
          {
            "check": "config",
            "device": "DSW1",
            "contains": "ip routing"
          }
        ],
        "hint": "Without ip routing the switch answers pings to its SVIs but won't forward between them."
      },
      {
        "title": "PC1 can ping PC2",
        "checks": [
          {
            "check": "ping",
            "from": "PC1",
            "to": "PC2"
          }
        ]
      }
    ]
  }
}
