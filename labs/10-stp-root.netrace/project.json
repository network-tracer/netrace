  "lab": {
    "title": "Choosing the spanning-tree root",
    "topic": "Switching",
    "brief": "Three switches in a triangle form a loop, so spanning tree blocks one port. The root bridge was chosen by the lowest MAC address, not by design. Make **SW3** the root for VLAN 1 and watch which port blocks.\n\nOpen the STP tab to see each port's role and why.",
    "tasks": [
      {
        "title": "SW3 is the root bridge for VLAN 1",
        "checks": [
          {
            "check": "stp_root",
            "device": "SW3",
            "vlan": 1
          }
        ],
        "detail": "On SW3: `spanning-tree vlan 1 root primary` (or `spanning-tree vlan 1 priority 4096`).",
        "hint": "The lowest bridge ID wins: priority first, then MAC address."
      }
    ]
  }
