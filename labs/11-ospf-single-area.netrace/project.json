  "lab": {
    "title": "OSPF in one area",
    "topic": "Routing",
    "brief": "Three routers in a triangle, all addressed, no routing protocol. Turn on **OSPF** in area 0 on all three so they learn every network on their own.\n\nOpen the OSPF tab to watch neighbours come up and see why each route was chosen.",
    "tasks": [
      {
        "title": "R1 runs OSPF with both neighbours",
        "checks": [
          {
            "check": "ospf_neighbors",
            "device": "R1",
            "count": 2
          }
        ],
        "detail": "`router ospf 1`, `network 0.0.0.0 255.255.255.255 area 0`.",
        "hint": "A neighbour only comes up when both ends run OSPF; R1 alone shows none."
      },
      {
        "title": "R2 and R3 run OSPF too",
        "checks": [
          {
            "check": "ospf_neighbors",
            "device": "R2",
            "count": 2
          },
          {
            "check": "ospf_neighbors",
            "device": "R3",
            "count": 2
          }
        ]
      },
      {
        "title": "R1 learns PC3's network from OSPF",
        "checks": [
          {
            "check": "route",
            "device": "R1",
            "network": "192.168.3.0",
            "prefix_len": 24,
            "source": "ospf"
          }
        ]
      },
      {
        "title": "PC1 can ping PC3",
        "checks": [
          {
            "check": "ping",
            "from": "PC1",
            "to": "PC3"
          }
        ]
      }
    ]
  }
