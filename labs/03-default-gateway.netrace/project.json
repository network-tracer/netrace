  "annotations": [],
  "lab": {
    "title": "Routing between two LANs",
    "topic": "Routing",
    "brief": "R1 joins two LANs, but its interfaces have no addresses and are shut down, and the PCs have no default gateway. Make PC1 and PC2 reach each other through R1.\n\nOpen R1's console (double-click it).",
    "tasks": [
      {
        "title": "R1 Gi0/0 is 192.168.1.1/24 and up",
        "checks": [
          {
            "check": "address",
            "device": "R1",
            "address": "192.168.1.1",
            "prefix_len": 24,
            "interface": "g0/0"
          },
          {
            "check": "interface_up",
            "device": "R1",
            "interface": "g0/0"
          }
        ],
        "detail": "`enable`, `configure terminal`, `interface g0/0`, `ip address 192.168.1.1 255.255.255.0`, `no shutdown`.",
        "hint": "Router interfaces start shut down. no shutdown brings the interface up."
      },
      {
        "title": "R1 Gi0/1 is 192.168.2.1/24 and up",
        "checks": [
          {
            "check": "address",
            "device": "R1",
            "address": "192.168.2.1",
            "prefix_len": 24,
            "interface": "g0/1"
          },
          {
            "check": "interface_up",
            "device": "R1",
            "interface": "g0/1"
          }
        ]
      },
      {
        "title": "Each PC uses R1 as its gateway",
        "checks": [
          {
            "check": "gateway",
            "device": "PC1",
            "gateway": "192.168.1.1"
          },
          {
            "check": "gateway",
            "device": "PC2",
            "gateway": "192.168.2.1"
          }
        ],
        "hint": "A PC sends anything outside its own network to its default gateway."
      },
      {
        "title": "PC1 can ping PC2",
        "checks": [
          {
            "check": "ping",
            "from": "PC1",
            "to": "PC2"
          }
        ]
      }
    ]
  }
}
