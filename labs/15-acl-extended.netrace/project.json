  "annotations": [],
  "lab": {
    "title": "An extended access list",
    "topic": "Security",
    "brief": "Stop PC2 from pinging SRV1 without blocking anything else. An **extended ACL** can match the protocol and the destination as well as the source, so apply it inbound on Gi0/0, close to PC2.",
    "tasks": [
      {
        "title": "ACL 101 denies pings from PC2 to SRV1",
        "checks": [
          {
            "check": "config",
            "device": "R1",
            "contains": "access-list 101 deny icmp host 192.168.1.11 host 192.168.2.10"
          }
        ],
        "detail": "`access-list 101 deny icmp host 192.168.1.11 host 192.168.2.10`"
      },
      {
        "title": "\u2026and permits everything else",
        "checks": [
          {
            "check": "config",
            "device": "R1",
            "contains": "access-list 101 permit ip any any"
          }
        ],
        "hint": "Without this line the implicit deny at the end blocks all traffic."
      },
      {
        "title": "It's applied in on Gi0/0",
        "checks": [
          {
            "check": "config",
            "device": "R1",
            "contains": "ip access-group 101 in"
          }
        ]
      },
      {
        "title": "PC2 can't ping SRV1; PC1 can",
        "checks": [
          {
            "check": "ping",
            "from": "PC2",
            "to": "SRV1",
            "succeeds": false
          },
          {
            "check": "ping",
            "from": "PC1",
            "to": "SRV1"
          }
        ]
      }
    ]
  }
}
