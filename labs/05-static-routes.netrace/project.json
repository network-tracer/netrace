  "lab": {
    "title": "Static routes",
    "topic": "Routing",
    "brief": "R1 and R2 are addressed and cabled, but each only knows its own networks. Add a static route on each so PC1 and PC2 can reach each other. Check `show ip route` as you go.",
    "tasks": [
      {
        "title": "R1 has a route to 192.168.2.0/24",
        "checks": [
          {
            "check": "route",
            "device": "R1",
            "network": "192.168.2.0",
            "prefix_len": 24,
            "source": "static"
          }
        ],
        "detail": "`ip route 192.168.2.0 255.255.255.0 10.0.0.2`",
        "hint": "The next hop is R2's address on the link between them."
      },
      {
        "title": "R2 has a route to 192.168.1.0/24",
        "checks": [
          {
            "check": "route",
            "device": "R2",
            "network": "192.168.1.0",
            "prefix_len": 24,
            "source": "static"
          }
        ],
        "hint": "Without the return route, pings reach PC2 but the replies can't come back."
      },
      {
        "title": "PC1 can ping PC2",
        "checks": [
          {
            "check": "ping",
            "from": "PC1",
            "to": "PC2"
          }
        ]
      }
    ]
  }
