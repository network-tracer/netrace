  "lab": {
    "title": "Port security",
    "topic": "Security",
    "brief": "Lock SW1 Fa0/1 to the one PC that belongs there: allow a single MAC address, learn it automatically, and shut the port down if anything else is plugged in.",
    "tasks": [
      {
        "title": "Fa0/1 is an access port with port security on",
        "checks": [
          {
            "check": "access_port",
            "device": "SW1",
            "port": "Fa0/1",
            "vlan": 1
          },
          {
            "check": "config",
            "device": "SW1",
            "contains": "switchport port-security"
          }
        ],
        "detail": "`interface fa0/1`, `switchport mode access`, `switchport port-security`.",
        "hint": "Port security only works on access (or trunk) ports, not dynamic ones."
      },
      {
        "title": "It learns the MAC address (sticky)",
        "checks": [
          {
            "check": "config",
            "device": "SW1",
            "contains": "switchport port-security mac-address sticky"
          }
        ]
      },
      {
        "title": "PC1 still works",
        "checks": [
          {
            "check": "ping",
            "from": "PC1",
            "to": "PC2"
          }
        ]
      }
    ]
  }
