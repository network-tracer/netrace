  "annotations": [],
  "lab": {
    "title": "Sharing one public address (PAT)",
    "topic": "Services",
    "brief": "The ISP only routes 203.0.113.0/24, so replies to the office's private addresses get lost. Use **PAT** on R1 so the whole LAN shares Gi0/1's address.",
    "tasks": [
      {
        "title": "Mark the inside and outside interfaces",
        "checks": [
          {
            "check": "config",
            "device": "R1",
            "contains": "ip nat inside"
          },
          {
            "check": "config",
            "device": "R1",
            "contains": "ip nat outside"
          }
        ],
        "detail": "Gi0/0: `ip nat inside`. Gi0/1: `ip nat outside`."
      },
      {
        "title": "Translate the LAN to Gi0/1's address",
        "checks": [
          {
            "check": "config",
            "device": "R1",
            "contains": "ip nat inside source list 1 interface GigabitEthernet0/1 overload"
          }
        ],
        "detail": "`access-list 1 permit 192.168.1.0 0.0.0.255`, then `ip nat inside source list 1 interface g0/1 overload`.",
        "hint": "overload is what lets many hosts share one address, told apart by port."
      },
      {
        "title": "PC1 and PC2 reach WEB",
        "checks": [
          {
            "check": "ping",
            "from": "PC1",
            "to": "WEB"
          },
          {
            "check": "ping",
            "from": "PC2",
            "to": "WEB"
          }
        ],
        "hint": "show ip nat translations lists each flow; the inspector shows each packet's addresses before and after."
      }
    ],
    "locked": [
      "ISP",
      "WEB"
    ]
  }
}
