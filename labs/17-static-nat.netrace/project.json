  "lab": {
    "title": "Publishing a server (static NAT)",
    "topic": "Services",
    "brief": "SRV1 has a private address, so nothing on the internet can reach it. Give it the public address **203.0.113.10** with static NAT, so WEB (on the internet) can reach it.",
    "tasks": [
      {
        "title": "Mark the inside and outside interfaces",
        "checks": [
          {
            "check": "config",
            "device": "R1",
            "contains": "ip nat inside"
          },
          {
            "check": "config",
            "device": "R1",
            "contains": "ip nat outside"
          }
        ]
      },
      {
        "title": "Map SRV1 to 203.0.113.10",
        "checks": [
          {
            "check": "config",
            "device": "R1",
            "contains": "ip nat inside source static 192.168.1.20 203.0.113.10"
          }
        ],
        "detail": "`ip nat inside source static 192.168.1.20 203.0.113.10`",
        "hint": "R1 answers ARP for 203.0.113.10 on the outside, so the ISP can deliver to it."
      },
      {
        "title": "WEB can reach SRV1 at its public address",
        "checks": [
          {
            "check": "ping",
            "from": "WEB",
            "to": "203.0.113.10"
          }
        ]
      }
    ]
  }
}
