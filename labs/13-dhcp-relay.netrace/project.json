  "annotations": [],
  "lab": {
    "title": "Reaching a DHCP server on another network",
    "topic": "Services",
    "brief": "A central router called DHCP already has a pool for 192.168.1.0/24, but PC1's Discover is a broadcast, and routers don't forward broadcasts. Make R1 **relay** it with a helper address.",
    "tasks": [
      {
        "title": "R1 Gi0/0 relays DHCP to 192.168.2.10",
        "checks": [
          {
            "check": "config",
            "device": "R1",
            "contains": "ip helper-address 192.168.2.10"
          }
        ],
        "detail": "`interface g0/0`, `ip helper-address 192.168.2.10`.",
        "hint": "The helper goes on the interface facing the clients, where the broadcasts arrive."
      },
      {
        "title": "PC1 gets a lease",
        "checks": [
          {
            "check": "dhcp_lease",
            "device": "PC1"
          }
        ]
      },
      {
        "title": "PC1 can ping the DHCP server",
        "checks": [
          {
            "check": "ping",
            "from": "PC1",
            "to": "192.168.2.10"
          }
        ]
      }
    ],
    "locked": [
      "DHCP"
    ]
  }
