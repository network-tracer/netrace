  "lab": {
    "title": "A standard access list",
    "topic": "Security",
    "brief": "PC1 and PC3 are on the office LAN; PC2's LAN holds payroll. Only PC1 may reach it. Write a **standard ACL** that permits PC1 and denies the rest, and apply it outbound on R1 Gi0/1, close to the destination.",
    "tasks": [
      {
        "title": "Access list 10 permits PC1",
        "checks": [
          {
            "check": "config",
            "device": "R1",
            "contains": "access-list 10 permit 192.168.1.10"
          }
        ],
        "detail": "`access-list 10 permit host 192.168.1.10`",
        "hint": "Every ACL ends with an invisible deny any, so you don't need to write the deny."
      },
      {
        "title": "It's applied out on Gi0/1",
        "checks": [
          {
            "check": "config",
            "device": "R1",
            "contains": "ip access-group 10 out"
          }
        ],
        "detail": "`interface g0/1`, `ip access-group 10 out`."
      },
      {
        "title": "PC1 reaches payroll, PC3 doesn't",
        "checks": [
          {
            "check": "ping",
            "from": "PC1",
            "to": "PC2"
          },
          {
            "check": "ping",
            "from": "PC3",
            "to": "PC2",
            "succeeds": false
          }
        ],
        "hint": "Click the dropped event in the Events tab: the inspector shows the line that matched."
      }
    ]
  }
}
