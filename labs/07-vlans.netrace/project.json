  "lab": {
    "title": "Splitting a switch with VLANs",
    "topic": "Switching",
    "brief": "Sales (PC1, PC3) and Staff (PC2, PC4) share SW1. Put them in separate VLANs so each group is its own broadcast domain: VLAN 10 Sales on Fa0/1 and Fa0/3, VLAN 20 Staff on Fa0/2 and Fa0/4.",
    "tasks": [
      {
        "title": "Create VLAN 10 Sales and VLAN 20 Staff",
        "checks": [
          {
            "check": "vlan",
            "device": "SW1",
            "vlan": 10,
            "name": "Sales"
          },
          {
            "check": "vlan",
            "device": "SW1",
            "vlan": 20,
            "name": "Staff"
          }
        ],
        "detail": "`vlan 10`, `name Sales`, then the same for 20."
      },
      {
        "title": "Fa0/1 and Fa0/3 are in VLAN 10",
        "checks": [
          {
            "check": "access_port",
            "device": "SW1",
            "port": "Fa0/1",
            "vlan": 10
          },
          {
            "check": "access_port",
            "device": "SW1",
            "port": "Fa0/3",
            "vlan": 10
          }
        ],
        "detail": "`interface range fa0/1, fa0/3`, `switchport mode access`, `switchport access vlan 10`."
      },
      {
        "title": "Fa0/2 and Fa0/4 are in VLAN 20",
        "checks": [
          {
            "check": "access_port",
            "device": "SW1",
            "port": "Fa0/2",
            "vlan": 20
          },
          {
            "check": "access_port",
            "device": "SW1",
            "port": "Fa0/4",
            "vlan": 20
          }
        ]
      },
      {
        "title": "Same VLAN talks, different VLANs don't",
        "checks": [
          {
            "check": "ping",
            "from": "PC1",
            "to": "PC3"
          },
          {
            "check": "ping",
            "from": "PC2",
            "to": "PC4"
          },
          {
            "check": "ping",
            "from": "PC1",
            "to": "PC2",
            "succeeds": false
          }
        ],
        "hint": "Different VLANs need a router to talk; that's the router-on-a-stick lab."
      }
    ]
  }
}
