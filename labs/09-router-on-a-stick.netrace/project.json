  "annotations": [],
  "lab": {
    "title": "Routing between VLANs (router on a stick)",
    "topic": "Switching",
    "brief": "PC1 (VLAN 10) and PC2 (VLAN 20) need to talk. Trunk SW1's uplink to R1, then give R1 one **subinterface** per VLAN on Gi0/0: .10 is 192.168.10.1/24 and .20 is 192.168.20.1/24.",
    "tasks": [
      {
        "title": "SW1 Gi0/1 is a trunk",
        "checks": [
          {
            "check": "trunk",
            "device": "SW1",
            "port": "g0/1"
          }
        ]
      },
      {
        "title": "R1 Gi0/0.10 routes VLAN 10",
        "checks": [
          {
            "check": "address",
            "device": "R1",
            "address": "192.168.10.1",
            "prefix_len": 24,
            "interface": "g0/0.10"
          },
          {
            "check": "config",
            "device": "R1",
            "contains": "encapsulation dot1Q 10"
          }
        ],
        "detail": "`interface g0/0.10`, `encapsulation dot1Q 10`, `ip address 192.168.10.1 255.255.255.0`.",
        "hint": "The encapsulation line tells the subinterface which VLAN tag it handles."
      },
      {
        "title": "R1 Gi0/0.20 routes VLAN 20",
        "checks": [
          {
            "check": "address",
            "device": "R1",
            "address": "192.168.20.1",
            "prefix_len": 24,
            "interface": "g0/0.20"
          },
          {
            "check": "config",
            "device": "R1",
            "contains": "encapsulation dot1Q 20"
          }
        ]
      },
      {
        "title": "PC1 can ping PC2",
        "checks": [
          {
            "check": "ping",
            "from": "PC1",
            "to": "PC2"
          }
        ]
      }
    ]
  }
}
