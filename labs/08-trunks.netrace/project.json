  "lab": {
    "title": "Carrying VLANs between switches",
    "topic": "Switching",
    "brief": "PC1 and PC3 are both in VLAN 10, but on different switches. The link between the switches is an access port in VLAN 1, so VLAN 10 can't cross it. Make it a **trunk**.",
    "tasks": [
      {
        "title": "SW1 Gi0/1 is a trunk",
        "checks": [
          {
            "check": "trunk",
            "device": "SW1",
            "port": "g0/1"
          }
        ],
        "detail": "`interface g0/1`, `switchport mode trunk`."
      },
      {
        "title": "SW2 Gi0/1 is a trunk",
        "checks": [
          {
            "check": "trunk",
            "device": "SW2",
            "port": "g0/1"
          }
        ]
      },
      {
        "title": "PC1 can ping PC3",
        "checks": [
          {
            "check": "ping",
            "from": "PC1",
            "to": "PC3"
          }
        ],
        "hint": "Frames on the trunk carry an 802.1Q tag saying which VLAN they belong to. Look for it in the inspector."
      }
    ]
  }
